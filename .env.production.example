# Plantilla para Vercel — Sistema PAI
# Configurar en: Vercel → Project → Settings → Environment Variables (Production)
# No commitear archivos .env con valores reales.

# --- Supabase (expuestas al navegador vía NEXT_PUBLIC_*) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Si tu proyecto usa la clave "publishable" nueva de Supabase, puedes usar en su lugar:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Solo servidor (Vercel: marcar como sensible; NUNCA prefijo NEXT_PUBLIC_) ---
# Service role: Route Handlers / lógica privilegiada en servidor únicamente
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Opcional: URL pública del sitio (redirecciones, enlaces absolutos)
# NEXT_PUBLIC_APP_URL=https://tu-proyecto.vercel.app
