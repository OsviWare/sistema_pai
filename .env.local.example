# Copiar a `.env.local` y completar con tus valores reales.
# Nunca subas `.env.local` ni pegues service_role / contraseña de BD en este archivo de ejemplo.

NEXT_PUBLIC_SUPABASE_URL=https://TU_REF.supabase.co

# Entrega 2A: publishable (si tu proyecto la muestra) — si no, deja vacío y usa solo ANON_KEY
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave pública anon (JWT) — Settings → API → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Obligatorio para POST /api/auth/registro (crea usuario Auth + fila usuarios_perfil).
# En Docker Compose debe estar en .env.local cargado por env_file.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: metadatos locales / CLI (no usar en el navegador)
# SUPABASE_ORGANIZATION_NAME=
# SUPABASE_PROJECT_NAME=
# SUPABASE_DATABASE_PASSWORD=
